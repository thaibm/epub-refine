# Gemini API Key (Lấy tại https://aistudio.google.com/)
# Hỗ trợ 1 hoặc NHIỀU key (phân cách bằng dấu phẩy) để tự động xoay tua (Round-robin) & nhân hạn mức RPM/RPD:
GEMINI_API_KEY=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...

# Hoặc khai báo theo từng dòng riêng lẻ:
# GEMINI_API_KEY_1=AIzaSyKey1...
# GEMINI_API_KEY_2=AIzaSyKey2...

GEMINI_MODEL=gemini-3.6-flash
