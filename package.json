{
  "name": "edit-epub",
  "version": "1.0.0",
  "description": "AI-powered EPUB editor for heading normalization, H2/H3 insertion, TOC rebuild, typo correction, and EPUB 3 popup footnote processing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "unpack": "tsx src/cli/unpack.ts",
    "pack": "tsx src/cli/pack.ts",
    "toc": "tsx src/cli/updateToc.ts",
    "inspect": "tsx src/cli/inspect.ts",
    "footnote": "tsx src/cli/footnote.ts",
    "pdf": "tsx src/cli/pdf.ts",
    "bilingual": "tsx src/cli/bilingual.ts",
    "translate": "tsx src/cli/bilingual.ts",
    "build": "tsc"
  },
  "keywords": [
    "epub",
    "gemini",
    "ai",
    "toc",
    "editor",
    "footnote"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@google/genai": "2.24.0",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "dotenv": "18.0.3",
    "jszip": "3.10.2",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
